generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  buyer
  seller
  admin
}

enum ItemStatus {
  draft
  active
  inactive
}

enum ServiceOrderStatus {
  pending
  in_progress
  delivered
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum ProductOrderStatus {
  new
  completed
  cancelled
}

enum ProductLanguage {
  ar
  en
  de
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(150)
  password   String   @db.VarChar(255)
  role       UserRole @default(buyer)
  is_active               Boolean   @default(true)
  avatar_url              String?   @db.VarChar(500)
  headline                String?   @db.VarChar(150)
  bio                     String?   @db.Text
  email_verified          Boolean   @default(false)
  email_verification_token String?  @db.VarChar(255)
  email_verification_expires DateTime?
  password_reset_token    String?   @db.VarChar(255)
  password_reset_expires  DateTime?
  public_id       String?  @unique @default(cuid()) @db.VarChar(50)
  profile_slug    String?  @unique @db.VarChar(100)
  stripe_account_id           String?  @db.VarChar(255)
  stripe_onboarding_complete  Boolean  @default(false)
  stripe_charges_enabled      Boolean  @default(false)
  stripe_payouts_enabled      Boolean  @default(false)
  stripe_details_submitted    Boolean  @default(false)

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  services Service[] @relation("UserServices")
  products Product[] @relation("UserProducts")

  service_orders_as_buyer  ServiceOrder[] @relation("ServiceOrderBuyer")
  service_orders_as_seller ServiceOrder[] @relation("ServiceOrderSeller")

  order_messages OrderMessage[] @relation("OrderMessageSender")
  order_files    OrderFile[]    @relation("OrderFileUploader")

  product_orders_as_buyer  ProductOrder[] @relation("ProductOrderBuyer")
  product_orders_as_seller ProductOrder[] @relation("ProductOrderSeller")

  notifications Notification[]
  service_inquiries_as_buyer  ServiceInquiry[] @relation("ServiceInquiryBuyer")
  service_inquiries_as_seller ServiceInquiry[] @relation("ServiceInquirySeller")
  service_inquiry_messages    ServiceInquiryMessage[] @relation("ServiceInquiryMessageSender")

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  services Service[]

  @@map("categories")
}

model Service {
  id                Int        @id @default(autoincrement())
  user_id           Int
  category_id       Int
  title             String     @db.VarChar(150)
  slug              String     @unique @db.VarChar(180)
  short_description String?    @db.VarChar(300)
  description       String?    @db.Text
  price             Decimal    @db.Decimal(10, 2)
  delivery_time     Int?
  status            ItemStatus @default(draft)
  is_featured       Boolean    @default(false)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  user     User     @relation("UserServices", fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  images ServiceImage[]
  orders ServiceOrder[]
  inquiries ServiceInquiry[]

  @@index([user_id, status], map: "svc_user_status_idx")
  @@index([status, category_id, is_featured, created_at], map: "svc_listing_idx")
  @@map("services")
}

model ServiceImage {
  id          Int      @id @default(autoincrement())
  service_id  Int
  image_url   String   @db.VarChar(500)
  is_cover    Boolean  @default(false)
  order_index Int      @default(0)
  created_at  DateTime @default(now())

  service Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id, is_cover, order_index, id], map: "svc_img_cover_idx")
  @@map("service_images")
}

model ServiceOrder {
  id                Int                @id @default(autoincrement())
  service_id        Int
  buyer_id          Int
  seller_id         Int
  price             Decimal            @db.Decimal(10, 2)
  status            ServiceOrderStatus @default(pending)
  delivery_deadline DateTime?
  payment_status           PaymentStatus @default(pending)
  payment_method           String?       @db.VarChar(50)
  stripe_session_id         String?       @unique @db.VarChar(255)
  stripe_payment_intent_id  String?       @db.VarChar(255)
  connected_account_id      String?       @db.VarChar(255)
  paid_at                   DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  service Service @relation(fields: [service_id], references: [id], onDelete: Cascade)
  buyer   User    @relation("ServiceOrderBuyer", fields: [buyer_id], references: [id], onDelete: Cascade)
  seller  User    @relation("ServiceOrderSeller", fields: [seller_id], references: [id], onDelete: Cascade)

  messages OrderMessage[]
  files    OrderFile[]

  @@index([seller_id, status, created_at], map: "so_seller_status_idx")
  @@index([buyer_id, status, created_at], map: "so_buyer_status_idx")
  @@index([payment_status, created_at], map: "so_payment_idx")
  @@map("service_orders")
}

model OrderMessage {
  id         Int      @id @default(autoincrement())
  order_id   Int
  sender_id  Int
  message    String   @db.Text
  attachment_url  String? @db.VarChar(500)
  attachment_name String? @db.VarChar(255)
  attachment_type String? @db.VarChar(100)
  attachment_size Int?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  order  ServiceOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  sender User         @relation("OrderMessageSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at], map: "ord_msg_order_idx")
  @@map("order_messages")
}

model OrderFile {
  id          Int      @id @default(autoincrement())
  order_id    Int
  uploaded_by Int
  file_url    String   @db.VarChar(500)
  file_name   String   @db.VarChar(255)
  file_size   Int?
  uploaded_at DateTime @default(now())

  order    ServiceOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  uploader User         @relation("OrderFileUploader", fields: [uploaded_by], references: [id], onDelete: Cascade)

  @@index([order_id, uploaded_at], map: "ord_file_order_idx")
  @@map("order_files")
}

model ProductCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  products Product[]

  @@map("product_categories")
}

model Product {
  id                Int        @id @default(autoincrement())
  user_id           Int
  category_id       Int
  title             String     @db.VarChar(150)
  slug              String     @unique @db.VarChar(180)
  short_description String?    @db.VarChar(300)
  description       String?    @db.Text
  price             Decimal    @db.Decimal(10, 2)
  thumbnail_url     String?    @db.VarChar(500)
  gallery_images    Json?
  status            ItemStatus @default(draft)
  is_featured       Boolean    @default(false)
  language          ProductLanguage @default(en)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  user     User            @relation("UserProducts", fields: [user_id], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)

  files  ProductFile[]
  orders ProductOrder[]

  @@index([user_id, status], map: "prod_user_status_idx")
  @@index([status, language, category_id, is_featured, created_at], map: "prod_listing_idx")
  @@map("products")
}

model ProductFile {
  id         Int      @id @default(autoincrement())
  product_id Int
  file_url   String   @db.VarChar(500)
  file_name  String   @db.VarChar(255)
  file_size  Int?
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_files")
}

model ProductOrder {
  id             Int                @id @default(autoincrement())
  product_id     Int
  buyer_id       Int
  seller_id      Int
  price          Decimal            @db.Decimal(10, 2)
  payment_method String?            @db.VarChar(50)
  payment_status PaymentStatus      @default(pending)
  order_status   ProductOrderStatus @default(new)
  stripe_session_id        String? @unique @db.VarChar(255)
  stripe_payment_intent_id String? @db.VarChar(255)
  connected_account_id      String? @db.VarChar(255)
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  buyer   User    @relation("ProductOrderBuyer", fields: [buyer_id], references: [id], onDelete: Cascade)
  seller  User    @relation("ProductOrderSeller", fields: [seller_id], references: [id], onDelete: Cascade)

  @@index([seller_id, payment_status, order_status, created_at], map: "po_seller_pay_idx")
  @@index([buyer_id, payment_status, order_status, created_at], map: "po_buyer_pay_idx")
  @@map("product_orders")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String   @db.VarChar(80)
  title      String   @db.VarChar(255)
  message    String   @db.Text
  link       String?  @db.VarChar(500)
  is_read    Boolean  @default(false)
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@index([created_at])
  @@index([user_id, created_at], map: "notif_user_created_idx")
  @@index([user_id, is_read], map: "notif_user_read_idx")
  @@map("notifications")
}

model ServiceInquiry {
  id         Int      @id @default(autoincrement())
  service_id Int
  buyer_id   Int
  seller_id  Int
  status     String   @default("open") @db.VarChar(30)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  service Service @relation(fields: [service_id], references: [id], onDelete: Cascade)
  buyer   User    @relation("ServiceInquiryBuyer", fields: [buyer_id], references: [id], onDelete: Cascade)
  seller  User    @relation("ServiceInquirySeller", fields: [seller_id], references: [id], onDelete: Cascade)
  messages ServiceInquiryMessage[]

  @@index([service_id])
  @@index([buyer_id])
  @@index([seller_id])
  @@map("service_inquiries")
}

model ServiceInquiryMessage {
  id         Int      @id @default(autoincrement())
  inquiry_id Int
  sender_id  Int
  message    String   @db.Text
  attachment_url  String? @db.VarChar(500)
  attachment_name String? @db.VarChar(255)
  attachment_type String? @db.VarChar(100)
  attachment_size Int?
  created_at DateTime @default(now())

  inquiry ServiceInquiry @relation(fields: [inquiry_id], references: [id], onDelete: Cascade)
  sender  User           @relation("ServiceInquiryMessageSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([inquiry_id])
  @@index([sender_id])
  @@map("service_inquiry_messages")
}
